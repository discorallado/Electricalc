  "notas": [
    "Valores máximos de operación; se corrigen con los factores de las tablas N°4.6 y N°4.7 (numeral 6.2.6: Ic = It × fn × ft).",
    "Aplican a cables aislados sin armadura, para tensiones que no excedan 1 kV CA o 1,5 kV CC, sin exposición directa a radiación solar.",
    "Aplicables a conductores monopolares o multipolares en ductos (numeral 6.2.3). El conductor de protección no se considera activo."
  ],
  "metodos": {
    "A1": "Hasta tres conductores monopolares con carga, instalados en ductos embutidos en paredes.",
    "A2": "Cables multiconductores (3 conductores con carga) instalados en ductos embutidos en paredes.",
    "B1": "Hasta tres conductores monopolares instalados en ductos o en bandejas adosadas a paredes.",
    "B2": "Cables multiconductores (3 conductores con carga) instalados en ductos o en bandejas adosadas a paredes.",
    "D1": "Cables monoconductores o multiconductores (3 conductores con carga) instalados en ductos enterrados.",
    "D2": "Cables con cubierta, monoconductores o multiconductores (3 conductores con carga) instalados directamente enterrados.",
    "E": "Cables multiconductores (3 conductores con carga) instalados libremente al aire, en escalerillas, canastillos o bandejas perforadas.",
    "F": "Cables monoconductores (3 conductores con carga), en contacto y en disposición plana, instalados libremente al aire, en escalerillas, canastillos o bandejas perforadas."
  },
  "nota_enterrados": "Para instalaciones enterradas se considera una profundidad de 0,7 m y una resistividad térmica del suelo de 1 K·m/W.",
